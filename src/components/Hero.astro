<section class="hero">
  <div class="container hero-grid">

    <div class="hero-content">
      <p class="label">WELD PQ / USA</p>

      <h1>
        BUILD.<br />
        WELD.<br />
        CREATE.
      </h1>

      <p class="intro">
        Practical welding, fabrication and shop tool ideas —
        built, tested and shared from the workshop.
      </p>

      <div class="actions">
        <a href="/projects/" class="primary-button">
          Explore Projects
          <span>→</span>
        </a>

        <a
          href="https://www.youtube.com/@WELDPQ"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          Watch on YouTube
          <span>↗</span>
        </a>
      </div>
    </div>


    <div class="hero-visual">

      <div
        class="hero-slider"
        data-hero-slider
        aria-roledescription="carousel"
        aria-label="WELD PQ workshop images"
      >

        <!-- IMAGE 01 -->
        <div
          class="slide is-active"
          data-slide
          aria-hidden="false"
        >
          <img
            src="/images/hero/hero-1.jpg"
            alt="WELD PQ team"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            draggable="false"
          />
        </div>

        <!-- IMAGE 02 -->
        <div
          class="slide"
          data-slide
          aria-hidden="true"
        >
          <img
            src="/images/hero/hero-2.jpg"
            alt="WELD PQ workshop"
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </div>

        <!-- IMAGE 03 -->
        <div
          class="slide"
          data-slide
          aria-hidden="true"
        >
          <img
            src="/images/hero/hero-3.jpg"
            alt="WELD PQ fabrication project"
            loading="eager"
            decoding="async"
            draggable="false"
          />
        </div>


        <!-- DARK GRADIENT -->
        <div class="image-overlay"></div>


        <!-- BRAND -->
        <div class="image-brand">
          WELD PQ
        </div>


        <!-- BOTTOM INFO -->
        <div class="technical-info">
          <span>WORKSHOP / USA</span>
          <span>WELDING • FABRICATION</span>
        </div>


        <!-- SLIDE INDICATOR -->
        <div class="slider-indicator" aria-live="polite">
          <span data-current-slide>01</span>
          <span class="indicator-line"></span>
          <span>03</span>
        </div>


        <!-- PREVIOUS / NEXT -->
        <div class="slider-controls">
          <button
            class="slider-button"
            type="button"
            data-prev-slide
            aria-label="Previous image"
          >
            ←
          </button>

          <div class="slider-dots" aria-label="Choose hero image">
            <button
              class="slider-dot is-active"
              type="button"
              data-slide-dot="0"
              aria-label="Show image 1"
              aria-current="true"
            ></button>

            <button
              class="slider-dot"
              type="button"
              data-slide-dot="1"
              aria-label="Show image 2"
              aria-current="false"
            ></button>

            <button
              class="slider-dot"
              type="button"
              data-slide-dot="2"
              aria-label="Show image 3"
              aria-current="false"
            ></button>
          </div>

          <button
            class="slider-button"
            type="button"
            data-next-slide
            aria-label="Next image"
          >
            →
          </button>
        </div>

      </div>

    </div>

  </div>
</section>


<script>
  const heroSlider = document.querySelector("[data-hero-slider]");

  if (heroSlider instanceof HTMLElement) {
    const slides = Array.from(
      heroSlider.querySelectorAll("[data-slide]")
    );

    const dots = Array.from(
      heroSlider.querySelectorAll("[data-slide-dot]")
    );

    const previousButton =
      heroSlider.querySelector("[data-prev-slide]");

    const nextButton =
      heroSlider.querySelector("[data-next-slide]");

    const currentSlideLabel =
      heroSlider.querySelector("[data-current-slide]");

    const AUTO_DELAY = 5000;
    const SWIPE_THRESHOLD = 45;

    let currentIndex = 0;
    let autoTimer;
    let pointerStartX = null;
    let pointerStartY = null;


    function normalizeIndex(index) {
      return (
        (index % slides.length) +
        slides.length
      ) % slides.length;
    }


    function updateSliderRatio(index) {
      const slide = slides[index];
      const image = slide?.querySelector("img");

      if (!(image instanceof HTMLImageElement)) {
        return;
      }

      const applyRatio = () => {
        if (
          image.naturalWidth > 0 &&
          image.naturalHeight > 0
        ) {
          heroSlider.style.aspectRatio =
            `${image.naturalWidth} / ${image.naturalHeight}`;
        }
      };

      if (image.complete) {
        applyRatio();
      } else {
        image.addEventListener(
          "load",
          applyRatio,
          { once: true }
        );
      }
    }


    function showSlide(index) {
      if (slides.length === 0) return;

      currentIndex = normalizeIndex(index);

      updateSliderRatio(currentIndex);

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === currentIndex;

        slide.classList.toggle(
          "is-active",
          active
        );

        slide.setAttribute(
          "aria-hidden",
          String(!active)
        );
      });

      dots.forEach((dot, dotIndex) => {
        const active = dotIndex === currentIndex;

        dot.classList.toggle(
          "is-active",
          active
        );

        dot.setAttribute(
          "aria-current",
          String(active)
        );
      });

      if (currentSlideLabel) {
        currentSlideLabel.textContent =
          String(currentIndex + 1).padStart(2, "0");
      }
    }


    function stopAutoPlay() {
      if (autoTimer !== undefined) {
        window.clearTimeout(autoTimer);
        autoTimer = undefined;
      }
    }


    function startAutoPlay() {
      stopAutoPlay();

      if (slides.length <= 1) {
        return;
      }

      autoTimer = window.setTimeout(
        () => {
          showSlide(currentIndex + 1);
          startAutoPlay();
        },
        AUTO_DELAY
      );
    }


    function goToSlide(index) {
      showSlide(index);
      startAutoPlay();
    }


    previousButton?.addEventListener(
      "click",
      () => {
        goToSlide(currentIndex - 1);
      }
    );


    nextButton?.addEventListener(
      "click",
      () => {
        goToSlide(currentIndex + 1);
      }
    );


    dots.forEach((dot) => {
      dot.addEventListener(
        "click",
        () => {
          const index = Number(
            dot.getAttribute("data-slide-dot")
          );

          if (Number.isFinite(index)) {
            goToSlide(index);
          }
        }
      );
    });


    heroSlider.addEventListener(
      "pointerdown",
      (event) => {
        if (event.pointerType === "mouse") {
          return;
        }

        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
      }
    );


    heroSlider.addEventListener(
      "pointerup",
      (event) => {
        if (
          pointerStartX === null ||
          pointerStartY === null
        ) {
          return;
        }

        const deltaX =
          event.clientX - pointerStartX;

        const deltaY =
          event.clientY - pointerStartY;

        pointerStartX = null;
        pointerStartY = null;

        if (
          Math.abs(deltaX) < SWIPE_THRESHOLD ||
          Math.abs(deltaX) <= Math.abs(deltaY)
        ) {
          return;
        }

        if (deltaX < 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    );


    heroSlider.addEventListener(
      "pointercancel",
      () => {
        pointerStartX = null;
        pointerStartY = null;
      }
    );


    document.addEventListener(
      "visibilitychange",
      () => {
        if (document.hidden) {
          stopAutoPlay();
        } else {
          startAutoPlay();
        }
      }
    );


    showSlide(0);
    startAutoPlay();
  }
</script>


