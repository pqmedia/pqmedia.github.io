---
const currentYear = new Date().getFullYear();
const contactEmail = "weld.pqmediacentral@gmail.com";
---

<footer class="site-footer">

  <!-- ================================
       CTA
  ================================= -->
  <div class="footer-cta">
    <div class="container footer-cta-grid">

      <div>
        <p class="footer-eyebrow">
          QUESTIONS / IDEAS / PARTNERSHIPS
        </p>

        <h2>
          HAVE SOMETHING<br />
          TO TALK ABOUT?
        </h2>
      </div>

      <div class="footer-cta-copy">
        <p>
          Project questions, useful ideas, corrections,
          collaborations and business inquiries are welcome.
          Send us the context and start the conversation.
        </p>

        <div class="footer-cta-actions">
          <a
            class="footer-primary-action"
            href={`mailto:${contactEmail}?subject=Hello%20WELD%20PQ`}
          >
            CONTACT WELD PQ
            <span>→</span>
          </a>

          <a class="footer-secondary-action" href="/contact/">
            CONTACT DETAILS
            <span>↗</span>
          </a>
        </div>
      </div>

    </div>
  </div>


  <!-- ================================
       MAIN FOOTER
  ================================= -->
  <div class="container">

    <div class="footer-main">

      <div class="footer-brand">
        <a href="/" class="brand">
          WELD PQ
        </a>

        <p>
          Practical welding, fabrication, shop tools
          and workshop ideas — built, documented
          and shared from the workshop.
        </p>

        <div class="footer-contact">
          <span>CONTACT</span>

          <a href={`mailto:${contactEmail}`}>
            {contactEmail}
          </a>

          <small>
            WELD PQ / PQ MEDIA / UNITED STATES
          </small>
        </div>
      </div>


      <nav class="footer-nav" aria-label="Footer navigation">

        <div>
          <span class="nav-title">Explore</span>

          <a href="/projects/">Projects</a>
          <a href="/blog/">Workshop Notes</a>
          <a href="/our-story/">Our Story</a>
        </div>


        <div>
          <span class="nav-title">WELD PQ</span>

          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>

          <a
            href="https://www.youtube.com/@WELDPQ"
            target="_blank"
            rel="noopener noreferrer"
          >
            YouTube ↗
          </a>
        </div>


        <div>
          <span class="nav-title">Contact For</span>

          <a
            href={`mailto:${contactEmail}?subject=WELD%20PQ%20-%20General%20Question`}
          >
            Project Questions
          </a>

          <a
            href={`mailto:${contactEmail}?subject=WELD%20PQ%20-%20Idea%20or%20Contribution`}
          >
            Ideas & Contributions
          </a>

          <a
            href={`mailto:${contactEmail}?subject=WELD%20PQ%20-%20Business%20and%20Partnerships`}
          >
            Partnerships
          </a>
        </div>


        <div>
          <span class="nav-title">Information</span>

          <a href="/safety/">Safety</a>
          <a href="/privacy/">Privacy</a>
          <a href="/contact/">Media & Permissions</a>
        </div>

      </nav>

    </div>


    <div class="footer-note">
      <span>BUILD. WELD. CREATE.</span>

      <p>
        Follow WELD PQ for practical workshop projects,
        fabrication ideas and new builds.
      </p>

      <a
        href="https://www.youtube.com/@WELDPQ"
        target="_blank"
        rel="noopener noreferrer"
      >
        FOLLOW ON YOUTUBE ↗
      </a>
    </div>


    <div class="footer-bottom">

      <div>
        <span>WELD PQ</span>
        <span>Operated by PQ Media</span>
        <span>United States</span>
      </div>


      <div>
        <a href="/privacy/">Privacy</a>
        <a href="/safety/">Safety</a>
        <span>© {currentYear} PQ Media</span>
        <span>All rights reserved.</span>
      </div>

    </div>

  </div>
</footer>


<style>
  .site-footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .footer-cta {
    padding: 90px 0;
    background: var(--graphite);
    color: #fff;
  }

  .footer-cta-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(360px, 5fr);
    gap: clamp(60px, 8vw, 120px);
    align-items: end;
  }

  .footer-eyebrow {
    margin: 0 0 22px;
    color: #c96a5f;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .footer-cta h2 {
    max-width: 760px;
    margin: 0;
    color: #fff;
    font-size: clamp(52px, 6.3vw, 98px);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .footer-cta-copy p {
    max-width: 540px;
    margin: 0 0 30px;
    color: rgba(255, 255, 255, 0.72);
    font-size: 16px;
    line-height: 1.75;
  }

  .footer-cta-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .footer-primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    min-width: 215px;
    padding: 16px 18px;
    background: #fff;
    color: var(--graphite);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.11em;
  }

  .footer-secondary-action {
    display: inline-flex;
    gap: 8px;
    padding-bottom: 7px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.7);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(280px, 4fr) minmax(0, 8fr);
    gap: clamp(60px, 7vw, 110px);
    padding: 95px 0 80px;
  }

  .brand {
    display: inline-block;
    margin-bottom: 24px;
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .footer-brand > p {
    max-width: 390px;
    margin: 0;
    font-size: 15px;
    line-height: 1.8;
  }

  .footer-contact {
    margin-top: 38px;
    padding-top: 22px;
    border-top: 1px solid var(--border);
  }

  .footer-contact span {
    display: block;
    margin-bottom: 9px;
    color: var(--text-secondary);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .footer-contact a {
    display: block;
    margin-bottom: 10px;
    font-size: 13px;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .footer-contact a:hover {
    color: var(--accent);
  }

  .footer-contact small {
    color: var(--text-secondary);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .footer-nav {
    display: grid;
    grid-template-columns: repeat(4, minmax(120px, 1fr));
    gap: 44px 34px;
  }

  .footer-nav > div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .nav-title {
    margin-bottom: 12px;
    color: var(--text-secondary);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-nav a {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.45;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .footer-note {
    display: grid;
    grid-template-columns: minmax(180px, 3fr) minmax(300px, 6fr) auto;
    gap: 35px;
    align-items: center;
    padding: 28px 0;
    border-top: 1px solid var(--border);
  }

  .footer-note span {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }

  .footer-note p {
    max-width: 560px;
    margin: 0;
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.65;
  }

  .footer-note a {
    padding-bottom: 6px;
    border-bottom: 1px solid var(--text);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--border);
  }

  .footer-bottom > div {
    display: flex;
    flex-wrap: wrap;
    gap: 25px;
  }

  .footer-bottom span,
  .footer-bottom a {
    color: var(--text-secondary);
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-bottom a:hover {
    color: var(--text);
  }

  @media (max-width: 1000px) {
    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-note {
      grid-template-columns: 1fr 2fr;
    }

    .footer-note a {
      grid-column: 2;
      justify-self: start;
    }
  }

  @media (max-width: 800px) {
    .footer-cta-grid {
      grid-template-columns: 1fr;
      gap: 55px;
    }
  }

  @media (max-width: 600px) {
    .footer-cta {
      padding: 75px 0;
    }

    .footer-cta-actions {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-primary-action {
      width: 100%;
    }

    .footer-main {
      padding: 75px 0 60px;
    }

    .footer-nav {
      grid-template-columns: 1fr 1fr;
      gap: 45px 26px;
    }

    .footer-note {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .footer-note a {
      grid-column: 1;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 20px;
    }

    .footer-bottom > div {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
