---
import { getCollection } from "astro:content";

const projects = await getCollection(
  "projects",
  ({ data }) => data.draft !== true
);

projects.sort(
  (a, b) =>
    b.data.pubDate.valueOf() -
    a.data.pubDate.valueOf()
);

const featuredProject =
  projects.find(
    (project) => project.data.featured === true
  ) ?? projects[0];
---

<section class="featured-build section">
  <div class="container">

    <div class="section-top">

      <div>
        <p class="label">
          01 — Featured Build
        </p>

        <h2>
          BUILT IN THE<br />
          WORKSHOP.
        </h2>
      </div>

      <p class="section-intro">
        Real tools, fabrication projects and practical ideas
        developed and tested in the WELD PQ workshop.
      </p>

    </div>


    {
      featuredProject ? (

        <article class="featured-project">

          <a
            href={`/projects/${featuredProject.id}/`}
            class="project-image"
          >

            <img
              src={featuredProject.data.image}
              alt={featuredProject.data.imageAlt}
            />

            <div class="project-overlay"></div>

            <span class="project-code">
              FEATURED / 001
            </span>

            <div class="image-meta">
              <span>WELD PQ</span>
              <span>{featuredProject.data.category}</span>
            </div>

          </a>


          <div class="project-content">

            <div class="project-main">

              <p class="project-category">
                {featuredProject.data.category}
              </p>

              <h3>
                <a
                  href={`/projects/${featuredProject.id}/`}
                >
                  {featuredProject.data.title}
                </a>
              </h3>

              <p class="project-description">
                {featuredProject.data.description}
              </p>

            </div>


            <div class="project-specs">

              <div class="spec">
                <span>MATERIAL</span>

                <strong>
                  {
                    featuredProject.data.material
                      ?? "Workshop Build"
                  }
                </strong>
              </div>


              <div class="spec">
                <span>PROCESS</span>

                <strong>
                  {
                    featuredProject.data.processes.length > 0
                      ? featuredProject.data.processes
                          .slice(0, 2)
                          .join(" / ")
                      : "Fabrication"
                  }
                </strong>
              </div>


              <div class="spec">
                <span>TYPE</span>

                <strong>
                  {featuredProject.data.category}
                </strong>
              </div>


              <div class="spec">
                <span>DIFFICULTY</span>

                <strong>
                  {
                    featuredProject.data.difficulty
                      ?? "Workshop Project"
                  }
                </strong>
              </div>

            </div>


            <div class="project-actions">

              <a
                href={`/projects/${featuredProject.id}/`}
                class="primary-button"
              >
                View Project
                <span>→</span>
              </a>


              {
                featuredProject.data.youtube && (

                  <a
                    href={featuredProject.data.youtube}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-link"
                  >
                    Watch Build
                    <span>↗</span>
                  </a>

                )
              }

            </div>

          </div>

        </article>

      ) : (

        <div class="empty-project">

          <p>
            Featured project coming soon.
          </p>

        </div>

      )
    }

  </div>
</section>


<style>

  .featured-build {
    border-top: 1px solid var(--border);
  }


  /* HEADER */

  .section-top {
    display: grid;

    grid-template-columns:
      minmax(0, 2fr)
      minmax(280px, 1fr);

    gap: 80px;

    align-items: end;

    margin-bottom: 80px;
  }


  .section-top h2 {
    margin: 0;

    font-size:
      clamp(54px, 6vw, 92px);

    font-weight: 600;

    line-height: 0.95;
  }


  .section-intro {
    max-width: 430px;

    margin: 0;

    font-size: 18px;

    line-height: 1.75;
  }


  /* PROJECT */

  .featured-project {
    display: grid;

    grid-template-columns:
      minmax(0, 7fr)
      minmax(350px, 5fr);

    gap:
      clamp(45px, 6vw, 90px);

    align-items: stretch;
  }


  /* IMAGE */

  .project-image {
    position: relative;

    display: block;

    min-height: 700px;

    overflow: hidden;

    background:
      var(--graphite);
  }


  .project-image img {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    object-position: center;

    transition:
      transform 0.8s ease;
  }


  .project-image:hover img {
    transform:
      scale(1.025);
  }


  .project-overlay {
    position: absolute;

    inset: 0;

    pointer-events: none;

    background:
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.02) 40%,
        rgba(0,0,0,0.58) 100%
      );
  }


  .project-code {
    position: absolute;

    top: 26px;
    left: 26px;

    z-index: 2;

    color: white;

    font-size: 10px;

    font-weight: 700;

    letter-spacing:
      0.15em;
  }


  .image-meta {
    position: absolute;

    left: 26px;
    right: 26px;

    bottom: 24px;

    z-index: 2;

    display: flex;

    justify-content:
      space-between;

    gap: 20px;

    padding-top: 18px;

    border-top:
      1px solid rgba(
        255,
        255,
        255,
        0.55
      );

    color: white;
  }


  .image-meta span {
    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      0.13em;

    text-transform:
      uppercase;
  }


  /* CONTENT */

  .project-content {
    display: flex;

    flex-direction: column;

    justify-content:
      space-between;

    gap: 60px;

    padding: 8px 0;
  }


  .project-category {
    margin: 0 0 28px;

    color:
      var(--accent);

    font-size: 11px;

    font-weight: 700;

    letter-spacing:
      0.14em;

    text-transform:
      uppercase;
  }


  .project-content h3 {
    margin: 0 0 36px;

    font-size:
      clamp(46px, 4.8vw, 74px);

    font-weight: 600;

    line-height: 1;

    letter-spacing:
      -0.045em;
  }


  .project-content h3 a {
    transition:
      color 0.2s ease;
  }


  .project-content h3 a:hover {
    color:
      var(--accent);
  }


  .project-description {
    max-width: 470px;

    margin: 0;

    font-size: 18px;

    line-height: 1.75;
  }


  /* SPECS */

  .project-specs {
    display: grid;

    grid-template-columns:
      1fr 1fr;

    border-top:
      1px solid var(--border);

    border-bottom:
      1px solid var(--border);
  }


  .spec {
    padding:
      22px 0;
  }


  .spec:nth-child(even) {
    padding-left: 25px;

    border-left:
      1px solid var(--border);
  }


  .spec:nth-child(n + 3) {
    border-top:
      1px solid var(--border);
  }


  .spec span {
    display: block;

    margin-bottom: 7px;

    color:
      var(--text-secondary);

    font-size: 9px;

    font-weight: 700;

    letter-spacing:
      0.14em;
  }


  .spec strong {
    font-size: 14px;

    font-weight: 600;
  }


  /* ACTIONS */

  .project-actions {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 30px;
  }


  /* EMPTY */

  .empty-project {
    padding: 80px 0;

    border-top:
      1px solid var(--border);

    border-bottom:
      1px solid var(--border);
  }


  /* TABLET */

  @media (max-width: 900px) {

    .section-top {
      grid-template-columns: 1fr;

      gap: 30px;

      margin-bottom: 55px;
    }


    .featured-project {
      grid-template-columns: 1fr;
    }


    .project-image {
      min-height: 560px;
    }


    .project-content {
      gap: 50px;
    }

  }


  /* MOBILE */

  @media (max-width: 520px) {

    .project-image {
      min-height: 430px;
    }


    .project-specs {
      grid-template-columns: 1fr;
    }


    .spec:nth-child(even) {
      padding-left: 0;

      border-left: 0;
    }


    .spec + .spec {
      border-top:
        1px solid var(--border);
    }


    .project-actions {
      flex-direction: column;

      align-items: flex-start;
    }

  }

</style>