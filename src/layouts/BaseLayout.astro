---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = "WELD PQ — Build. Weld. Create.",

  description =
    "Practical welding, fabrication, machining and workshop tool ideas from WELD PQ.",

  image = "/images/hero/hero-1.jpg",

  noindex = false,
} = Astro.props;


/*
  Canonical URL will automatically become active
  after we configure `site` in astro.config.mjs.
*/

const canonicalURL =
  Astro.site
    ? new URL(
        Astro.url.pathname,
        Astro.site
      ).toString()
    : undefined;


/*
  Convert social sharing image
  into an absolute URL after deployment.
*/

const socialImageURL =
  Astro.site
    ? new URL(
        image,
        Astro.site
      ).toString()
    : image;
---

<!doctype html>

<html lang="en">

  <head>

    <!-- =====================================
         BASIC
    ====================================== -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="generator"
      content={Astro.generator}
    />


    <!-- =====================================
         TITLE / DESCRIPTION
    ====================================== -->

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />


    <!-- =====================================
         SEARCH ENGINES
    ====================================== -->

    <meta
      name="robots"
      content={
        noindex
          ? "noindex, nofollow"
          : "index, follow, max-image-preview:large"
      }
    />


    {
      canonicalURL && (
        <link
          rel="canonical"
          href={canonicalURL}
        />
      )
    }


    <!-- =====================================
         OPEN GRAPH
         Facebook / LinkedIn / Discord etc.
    ====================================== -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="WELD PQ"
    />

    <meta
      property="og:locale"
      content="en_US"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:image"
      content={socialImageURL}
    />


    {
      canonicalURL && (
        <meta
          property="og:url"
          content={canonicalURL}
        />
      )
    }


    <!-- =====================================
         X / TWITTER
    ====================================== -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageURL}
    />


    <!-- =====================================
         FAVICON
    ====================================== -->

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
      sizes="any"
    />


    <!-- =====================================
         BROWSER
    ====================================== -->

    <meta
      name="theme-color"
      content="#f5f3ee"
    />


    <!-- =====================================
         FONTS
    ====================================== -->

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />

    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

  </head>


  <body>

    <slot />

  </body>

</html>