---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import {
  getCollection,
  render,
} from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection(
    "blog",
    ({ data }) => data.draft !== true
  );

  return posts.map((post) => ({
    params: {
      id: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — WELD PQ`}
  description={post.data.description}
>
  <Header />

  <main>
    <article>

      <header class="article-header">
        <div class="article-container">

          <p class="category">
            {post.data.category}
          </p>

          <h1>
            {post.data.title}
          </h1>

          <p class="article-description">
            {post.data.description}
          </p>

          <div class="meta">
            <span>WELD PQ</span>

            <span>
              {
                post.data.pubDate.toLocaleDateString(
                  "en-US",
                  {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  }
                )
              }
            </span>

            {
              post.data.readTime && (
                <span>
                  {post.data.readTime}
                </span>
              )
            }
          </div>

        </div>
      </header>


      <div class="article-image">
        <img
          src={post.data.image}
          alt={post.data.imageAlt}
        />
      </div>


      <div class="article-body">
        <Content />
      </div>

    </article>
  </main>

  <Footer />
</BaseLayout>


<style>
  .article-header {
    padding: 120px 24px 80px;
  }

  .article-container {
    width: min(100%, 1050px);
    margin-inline: auto;
  }

  .category {
    margin: 0 0 30px;

    color: var(--accent);

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 1000px;

    margin: 0 0 40px;

    font-size: clamp(56px, 7vw, 105px);
    font-weight: 600;

    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .article-description {
    max-width: 720px;

    margin: 0 0 38px;

    font-size: 21px;
    line-height: 1.65;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;

    gap: 25px;

    padding-top: 20px;

    border-top: 1px solid var(--border);
  }

  .meta span {
    color: var(--text-secondary);

    font-size: 9px;
    font-weight: 700;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-image {
    width: min(calc(100% - 48px), 1360px);
    height: min(72vh, 780px);

    margin: 0 auto 100px;

    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .article-body {
    width: min(calc(100% - 48px), 760px);

    margin: 0 auto;

    padding-bottom: 140px;

    font-size: 18px;
    line-height: 1.8;
  }

  .article-body :global(h2) {
    margin: 80px 0 25px;

    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;

    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .article-body :global(h3) {
    margin: 50px 0 20px;

    font-size: 28px;
    font-weight: 600;

    line-height: 1.15;
  }

  .article-body :global(p) {
    margin: 0 0 28px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 30px;

    padding-left: 24px;
  }

  .article-body :global(li) {
    margin-bottom: 10px;
  }

  .article-body :global(img) {
    width: 100%;

    margin: 45px 0;
  }

  @media (max-width: 600px) {
    .article-header {
      padding: 80px 16px 60px;
    }

    .article-image {
      width: calc(100% - 32px);
      height: 420px;

      margin-bottom: 70px;
    }

    .article-body {
      width: calc(100% - 32px);

      font-size: 17px;
    }
  }
</style>